# Copy to .env in the repo root and fill with real values. Never commit .env.

# --- Auth (Deliverable 1) ---
# HS256 signing secret for JWTs. Generate a real one for anything beyond a
# laptop demo, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-secret-please-change-me-32chars!

# --- Agent (Deliverable 4) ---
# Set one. OPENAI_API_KEY is used directly against OpenAI; if only
# OPENROUTER_API_KEY is set, MODEL_BASE_URL/MODEL_NAME below route through
# OpenRouter instead. gpt-4o-mini is the model this capstone budgets against.
OPENAI_API_KEY=sk-your-openai-key-here
OPENROUTER_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=gpt-4o-mini
